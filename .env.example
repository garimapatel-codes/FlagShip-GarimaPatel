# Copy this file to .env and fill in the values. NEVER commit .env (it is in .gitignore).
# Where to find the keys: Flagsmith dashboard > your environment > Environment Settings > Keys.

# Server-side key of the "Production" environment (starts with "ser."). Used by the robot
# players (npm run sim) and scripts/check-flagsmith.mjs. Secret: never put it in web code.
FLAGSMITH_SERVER_KEY=

# Server-side key of the separate "AA Check" environment (starts with "ser."). Used only by
# the A/A run (npm run sim -- --aa), so A/A data never mixes with the real experiment.
FLAGSMITH_SERVER_KEY_AA=

# Client-side key of the "Production" environment (the short Environment ID). Public by
# design; Vite puts it in the browser bundle for the human-playable game.
VITE_FLAGSMITH_CLIENT_KEY=

# ---------------------------------------------------------------------------------------
# Only for the setup / results scripts (scripts/setup-flagsmith.mjs, scripts/fetch-results.mjs).
# They use Flagsmith's Admin (Management) API. The bots and the game do not need these.
# ---------------------------------------------------------------------------------------

# ORGANISATION API key (secret!). Dashboard: click your Organisation name (top bar) >
# Organisation Settings > "API Access" tab > Create API Key. Leave "Is admin" switched on (the default).
# Shown only once. Sent as the header "Authorization: Api-Key <key>". It is NOT a "ser." key.
FLAGSMITH_ADMIN_API_KEY=

# Optional. Leave empty for Flagsmith Cloud (default https://api.flagsmith.com/api/v1/).
# Self-hosted: https://<your-host>/api/v1/
FLAGSMITH_API_URL=

# Optional. The number in the dashboard URL: app.flagsmith.com/project/<THIS NUMBER>/...
# The scripts read the project from the environment anyway; if you set this, they check it matches.
FLAGSMITH_PROJECT_ID=

# CLIENT-SIDE key (the short "Environment ID", NOT the "ser." key) of the Production environment.
# Dashboard: Production > Environment Settings > Keys (also shown in the dashboard URL after /environment/).
# The Admin API finds an environment by this key. If you leave it empty, the scripts use
# VITE_FLAGSMITH_CLIENT_KEY above (same value for Production).
FLAGSMITH_ENVIRONMENT_KEY=

# CLIENT-SIDE key of the separate "AA Check" environment (Environment ID). Used by --aa.
FLAGSMITH_ENVIRONMENT_KEY_AA=
